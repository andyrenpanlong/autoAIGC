# ============================================
# AI视频生成平台 - 环境变量配置
# ============================================

# 应用配置
APP_NAME="AI Video Generation Platform"
ENVIRONMENT="development"  # development, testing, production
DEBUG="true"
CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'

# 服务器配置
HOST="0.0.0.0"
PORT="8000"
WORKERS="4"

# 数据库配置
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_video_db"
DATABASE_POOL_SIZE="20"
DATABASE_MAX_OVERFLOW="40"

# Redis配置
REDIS_URL="redis://localhost:6379/0"
REDIS_POOL_SIZE="10"

# JWT配置
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# 文件存储配置
STORAGE_TYPE="local"  # local, minio, s3
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE="104857600"  # 100MB

# MinIO配置
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="ai-videos"

# S3配置（如果使用AWS S3）
S3_REGION="us-east-1"
S3_BUCKET="your-bucket-name"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"

# 模型配置
DEFAULT_MODEL_PROVIDER="local"  # local, openai, runway, pika, google, stability
ENABLE_LOCAL_MODELS="true"
LOCAL_MODELS_DIR="./models"

# LTX模型配置
LTX_MODEL_PATH="./models/ltx-2.3"
LTX_MODEL_VERSION="2.3"
LTX_CACHE_DIR="./cache/ltx"

# Stable Diffusion配置
SD_MODEL_PATH="./models/stable-diffusion-xl"
SD_MODEL_VERSION="xl-1.0"
SD_CACHE_DIR="./cache/sd"

# OpenAI配置
OPENAI_API_KEY="your-openai-api-key"
OPENAI_ORGANIZATION="your-org-id"
OPENAI_SORA_MODEL="sora-1.0"
OPENAI_LLM_MODEL="gpt-4-turbo"

# Runway配置
RUNWAY_API_KEY="your-runway-api-key"
RUNWAY_MODEL="gen-2"

# Pika配置
PIKA_API_KEY="your-pika-api-key"

# Google配置
GOOGLE_API_KEY="your-google-api-key"
GOOGLE_VEO_MODEL="veo-1.0"

# Stability AI配置
STABILITY_API_KEY="your-stability-api-key"
STABILITY_MODEL="stable-diffusion-xl-1024-v1-0"

# Anthropic配置（用于剧本生成）
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-3-opus-20240229"

# 本地LLM配置（Ollama）
LOCAL_LLM_URL="http://localhost:11434"
LOCAL_LLM_MODEL="llama3.1:8b"

# 任务队列配置
MAX_CONCURRENT_TASKS="4"
TASK_TIMEOUT_SECONDS="3600"
VIDEO_GENERATION_TIMEOUT="1800"

# 日志配置
LOG_LEVEL="INFO"
LOG_FILE="./logs/app.log"

# 监控配置
ENABLE_METRICS="true"
METRICS_PORT="9090"

# 邮件配置（用于密码重置）
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@ai-video-platform.com"

# 前端配置
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="AI Video Generator"
NEXT_PUBLIC_APP_DESCRIPTION="Create stunning videos with AI"

# ============================================
# 安全警告
# ============================================
# 1. 在生产环境中，请务必修改所有默认密码和密钥
# 2. 不要将包含敏感信息的.env文件提交到版本控制
# 3. 使用环境变量或密钥管理服务存储API密钥
# 4. 定期轮换JWT密钥和数据库密码
# ============================================

# 快速启动命令：
# 1. 复制此文件为 .env
# 2. 修改必要的配置（数据库、API密钥等）
# 3. 运行 docker-compose up -d
# 4. 访问 http://localhost:3000

# 开发模式启动：
# 1. 后端：cd backend && poetry install && uvicorn main:app --reload
# 2. 前端：cd frontend && npm install && npm run dev
# 3. Redis：docker run -p 6379:6379 redis:alpine
# 4. PostgreSQL：docker run -p 5432:5432 -e POSTGRES_PASSWORD=password postgres:alpine
